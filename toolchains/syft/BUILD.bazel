load("//toolchains/syft:toolchain.bzl", "syft_toolchain")

package(default_visibility = ["//visibility:public"])

syft_toolchain(
    name = "darwin_amd64_toolchain_impl",
    tool = "@rules_sbom_syft_darwin_amd64//:syft",
    default_format = "cyclonedx_json",
    supports_formats = [
        "cyclonedx_json",
        "spdx_json",
    ],
    wrapper = "//tools/syft_wrapper:syft_wrapper",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

toolchain(
    name = "darwin_amd64_toolchain",
    toolchain_type = "//toolchains:sbom_toolchain_type",
    toolchain = ":darwin_amd64_toolchain_impl",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

