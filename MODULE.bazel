module(
    name = "rules_sbom",
    version = "0.6.2",  # x-release-please-version
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.5.0")
bazel_dep(name = "rules_python", version = "0.32.0")
bazel_dep(name = "platforms", version = "1.0.0")

sbom_setup = use_extension("//sbom:extensions.bzl", "sbom_setup")
use_repo(
    sbom_setup,
    "rules_sbom_syft_darwin_amd64",
    "rules_sbom_syft_darwin_arm64",
    "rules_sbom_syft_linux_amd64",
    "rules_sbom_syft_linux_arm64",
    "rules_sbom_syft_windows_amd64",
)

register_toolchains(
    "//toolchains/syft:darwin_amd64_toolchain",
    "//toolchains/syft:darwin_arm64_toolchain",
    "//toolchains/syft:linux_amd64_toolchain",
    "//toolchains/syft:linux_arm64_toolchain",
    "//toolchains/syft:windows_amd64_toolchain",
)
